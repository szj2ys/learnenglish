/* =============================================
   Kinetic Studio Design System - Global Styles
   ============================================= */

page {
  --primary: #2b6c00;
  --primary-container: #58cc02;
  --primary-fixed: #87fe45;
  --primary-fixed-dim: #6be026;
  --on-primary: #ffffff;
  --on-primary-container: #1e5000;

  --secondary: #006590;
  --secondary-container: #2fb8ff;
  --secondary-fixed: #c8e6ff;
  --secondary-fixed-dim: #88ceff;
  --on-secondary: #ffffff;
  --on-secondary-container: #004666;

  --tertiary: #755b00;
  --tertiary-container: #ddad00;
  --tertiary-fixed: #ffdf92;
  --tertiary-fixed-dim: #f4bf00;
  --on-tertiary: #ffffff;
  --on-tertiary-container: #574300;

  --surface: #fbf9f8;
  --surface-bright: #fbf9f8;
  --surface-dim: #dbd9d9;
  --surface-container: #efeded;
  --surface-container-low: #f5f3f3;
  --surface-container-lowest: #ffffff;
  --surface-container-high: #eae8e7;
  --surface-container-highest: #e4e2e2;
  --surface-variant: #e4e2e2;

  --on-surface: #1b1c1c;
  --on-surface-variant: #3f4a36;
  --background: #fbf9f8;
  --on-background: #1b1c1c;

  --outline: #6f7b64;
  --outline-variant: #becbb1;
  --error: #ba1a1a;
  --error-container: #ffdad6;
  --on-error: #ffffff;
  --on-error-container: #93000a;

  --inverse-primary: #6be026;
  --inverse-surface: #303030;
  --inverse-on-surface: #f2f0f0;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';
  background-color: var(--surface);
  color: var(--on-surface);
  -webkit-font-smoothing: antialiased;
}

/* Utility: text colors */
.text-primary { color: var(--primary); }
.text-primary-container { color: var(--primary-container); }
.text-secondary { color: var(--secondary); }
.text-secondary-container { color: var(--secondary-container); }
.text-tertiary { color: var(--tertiary); }
.text-tertiary-container { color: var(--tertiary-container); }
.text-tertiary-fixed-dim { color: var(--tertiary-fixed-dim); }
.text-on-surface { color: var(--on-surface); }
.text-on-surface-variant { color: var(--on-surface-variant); }
.text-on-primary { color: var(--on-primary); }
.text-on-primary-container { color: var(--on-primary-container); }
.text-on-secondary-container { color: var(--on-secondary-container); }
.text-on-tertiary-container { color: var(--on-tertiary-container); }
.text-error { color: var(--error); }

/* Utility: bg colors */
.bg-primary { background-color: var(--primary); }
.bg-primary-container { background-color: var(--primary-container); }
.bg-primary-fixed { background-color: var(--primary-fixed); }
.bg-secondary { background-color: var(--secondary); }
.bg-secondary-container { background-color: var(--secondary-container); }
.bg-secondary-fixed { background-color: var(--secondary-fixed); }
.bg-tertiary { background-color: var(--tertiary); }
.bg-tertiary-container { background-color: var(--tertiary-container); }
.bg-tertiary-fixed { background-color: var(--tertiary-fixed); }
.bg-surface { background-color: var(--surface); }
.bg-surface-container { background-color: var(--surface-container); }
.bg-surface-container-low { background-color: var(--surface-container-low); }
.bg-surface-container-lowest { background-color: var(--surface-container-lowest); }
.bg-surface-container-high { background-color: var(--surface-container-high); }
.bg-surface-container-highest { background-color: var(--surface-container-highest); }
.bg-surface-variant { background-color: var(--surface-variant); }
.bg-error-container { background-color: var(--error-container); }
.bg-on-error-container { background-color: var(--on-error-container); }

/* 3D Tactile Button - Primary */
.btn-3d-primary {
  background-color: var(--primary-container);
  color: var(--on-primary);
  border-radius: 32rpx;
  border-bottom: 4rpx solid var(--primary);
  transition: all 0.1s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}
.btn-3d-primary:active {
  transform: translateY(4rpx);
  border-bottom-width: 4rpx;
}

/* 3D Tactile Button - Secondary */
.btn-3d-secondary {
  background-color: var(--secondary-fixed);
  color: var(--on-secondary-container);
  border-radius: 32rpx;
  border-bottom: 4rpx solid var(--secondary);
  transition: all 0.1s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}
.btn-3d-secondary:active {
  transform: translateY(4rpx);
  border-bottom-width: 4rpx;
}

/* Ambient shadow card */
.card-ambient {
  box-shadow: 0 16rpx 64rpx rgba(27, 28, 28, 0.06);
}

/* Ghost border */
.ghost-border {
  border: 2rpx solid rgba(190, 203, 177, 0.15);
}

/* Hide scrollbar */
.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

/* Safe area padding for bottom */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* =============================================
   Shared Layout Utilities
   ============================================= */

/* Page content wrapper - shared across all pages */
.page-content,
.main-content,
.profile-content,
.lb-content,
.edit-content {
  padding-top: calc(160rpx + constant(safe-area-inset-top));
  padding-top: calc(160rpx + env(safe-area-inset-top));
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* Section title - shared across pages */
.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--on-surface);
  margin-bottom: 32rpx;
  letter-spacing: -0.02em;
}
