.page-edit-profile {
  min-height: 100vh;
  background-color: var(--surface);
  position: relative;
}

/* Top Bar */
.edit-top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + constant(safe-area-inset-top));
  padding-top: calc(24rpx + env(safe-area-inset-top));
  background: rgba(251, 249, 248, 0.9);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
}

.edit-back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.edit-back-icon {
  font-size: 36rpx;
  color: var(--on-surface-variant);
  font-weight: 700;
}

.edit-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--on-surface);
  letter-spacing: -0.02em;
}

.edit-save-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.edit-save-icon {
  font-size: 36rpx;
  color: var(--primary-container);
  font-weight: 700;
}

/* Avatar */
.edit-avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.edit-avatar-wrap {
  position: relative;
  margin-bottom: 24rpx;
}

.edit-avatar {
  width: 256rpx;
  height: 256rpx;
  border-radius: 50%;
  background: var(--surface-container-high);
  border: 8rpx solid var(--surface-container-lowest);
  box-shadow: 0 16rpx 64rpx rgba(27, 28, 28, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.edit-avatar-text {
  font-size: 120rpx;
  font-weight: 900;
  color: var(--primary-container);
}

.edit-avatar-edit {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--surface-container-lowest);
  box-shadow: 0 4rpx 0 0 var(--primary);
}

.edit-avatar-edit:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 0 0 var(--primary);
}

.edit-avatar-icon {
  font-size: 28rpx;
}

.edit-avatar-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--secondary);
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

/* Form */
.edit-form {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.edit-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.edit-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--on-surface-variant);
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-left: 16rpx;
}

.edit-input {
  background: var(--surface-container-lowest);
  border-radius: 32rpx;
  padding: 32rpx 40rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--on-surface);
  border: 2rpx solid rgba(190, 203, 177, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(27, 28, 28, 0.06);
}

.edit-input:focus {
  border-color: var(--secondary);
  box-shadow: 0 0 0 4rpx var(--secondary-fixed);
}

/* Security */
.edit-security {
  margin-bottom: 48rpx;
}

.edit-section-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--on-surface-variant);
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-left: 16rpx;
  margin-bottom: 24rpx;
}

.security-card {
  background: var(--surface-container-low);
  border-radius: 32rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 24rpx rgba(27, 28, 28, 0.06);
}

.security-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: var(--surface-container-lowest);
  border-radius: 24rpx;
  margin-bottom: 8rpx;
}

.security-item:last-child {
  margin-bottom: 0;
}

.security-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.security-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.security-icon {
  font-size: 36rpx;
}

.security-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.security-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--on-surface);
}

.security-value {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--on-surface-variant);
}

.security-arrow {
  font-size: 36rpx;
  color: var(--outline);
  font-weight: 300;
}

/* Floating Save */
.edit-floating-save {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--surface) 60%, transparent);
  z-index: 40;
}

.save-btn {
  font-size: 36rpx;
  padding: 40rpx;
}

