.page-result {
  min-height: 100vh;
  background-color: var(--surface);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-x: hidden;
}

/* Ambient Background */
.ambient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 400rpx;
  background: linear-gradient(to bottom, rgba(135, 254, 69, 0.2), var(--surface));
  pointer-events: none;
  z-index: 0;
}

/* Top Bar */
.result-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + constant(safe-area-inset-top));
  padding-top: calc(24rpx + env(safe-area-inset-top));
  position: relative;
  z-index: 10;
}

.close-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-container-lowest);
  box-shadow: 0 8rpx 32rpx rgba(27, 28, 28, 0.06);
}

.close-icon {
  font-size: 32rpx;
  color: var(--on-surface-variant);
  font-weight: 600;
}

.xp-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--surface-container-lowest);
  padding: 12rpx 24rpx;
  border-radius: 9999rpx;
  box-shadow: 0 8rpx 32rpx rgba(27, 28, 28, 0.06);
}

.xp-icon {
  font-size: 28rpx;
  color: var(--tertiary-fixed-dim);
}

.xp-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--tertiary);
}

/* Main */
.result-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  position: relative;
  z-index: 1;
}

/* Celebration */
.celebration-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.mascot-wrapper {
  position: relative;
  width: 384rpx;
  height: 384rpx;
  margin-bottom: 48rpx;
}

.mascot-glow {
  position: absolute;
  top: 32rpx; right: 32rpx; bottom: 32rpx; left: 32rpx;
  background: var(--primary);
  filter: blur(64rpx);
  opacity: 0.2;
  border-radius: 50%;
}

.mascot-circle {
  position: relative;
  width: 384rpx;
  height: 384rpx;
  border-radius: 50%;
  background: var(--surface-container-lowest);
  border: 8rpx solid var(--surface-container-lowest);
  box-shadow: 0 32rpx 64rpx rgba(27, 28, 28, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.mascot-emoji {
  font-size: 192rpx;
}

.result-title {
  font-size: 80rpx;
  font-weight: 900;
  color: var(--primary);
  text-align: center;
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin-bottom: 16rpx;
}

.result-sub {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--on-surface-variant);
  text-align: center;
}

/* Stats */
.stats-row {
  display: flex;
  gap: 32rpx;
  width: 100%;
  max-width: 700rpx;
}

.stat-card {
  flex: 1;
  background: var(--surface-container-lowest);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(27, 28, 28, 0.06);
}

.stat-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
}

.accent-secondary {
  background: linear-gradient(90deg, var(--secondary-container), var(--secondary));
}

.accent-tertiary {
  background: linear-gradient(90deg, var(--tertiary-fixed-dim), var(--tertiary));
}

.stat-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.bg-secondary-fixed {
  background: var(--secondary-fixed);
}

.bg-tertiary-fixed {
  background: var(--tertiary-fixed);
}

.stat-icon {
  font-size: 48rpx;
  font-weight: 700;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 900;
  color: var(--on-surface);
  letter-spacing: -0.02em;
  line-height: 1;
}

.text-tertiary {
  color: var(--tertiary);
}

.stat-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--on-surface-variant);
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

/* Actions */
.result-actions {
  padding: 48rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
}

.action-btn {
  font-size: 36rpx;
  padding: 40rpx;
  gap: 16rpx;
  background: linear-gradient(105deg, var(--primary-container), var(--primary));
}

.review-btn {
  font-size: 32rpx;
  padding: 36rpx;
  gap: 16rpx;
  margin-top: 8rpx;
}
