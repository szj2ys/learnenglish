.page-leaderboard {
  min-height: 100vh;
  background-color: var(--surface);
  position: relative;
}

/* Top Bar */
.lb-top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + constant(safe-area-inset-top));
  padding-top: calc(24rpx + env(safe-area-inset-top));
  background: rgba(251, 249, 248, 0.9);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
}

.lb-top-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.menu-icon {
  font-size: 36rpx;
  color: var(--on-surface-variant);
}

.lb-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--primary-container);
  letter-spacing: -0.02em;
}

.lb-top-right {
  display: flex;
  align-items: center;
}

.streak-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(221, 173, 0, 0.1);
  padding: 12rpx 24rpx;
  border-radius: 9999rpx;
}

.streak-icon {
  font-size: 28rpx;
}

.streak-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--tertiary-container);
}

/* Header */
.lb-header {
  text-align: center;
  margin-bottom: 64rpx;
  margin-top: 16rpx;
}

.lb-header-title {
  display: block;
  font-size: 64rpx;
  font-weight: 900;
  color: var(--on-surface);
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin-bottom: 16rpx;
}

.lb-header-sub {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--on-surface-variant);
}

/* Podium */
.podium-section {
  margin-bottom: 64rpx;
}

.podium-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 16rpx;
  height: 520rpx;
}

.podium-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 220rpx;
  position: relative;
}

.podium-item.gold {
  width: 280rpx;
  z-index: 10;
}

.podium-avatar-wrap {
  position: relative;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.podium-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--surface-container-high);
  border: 8rpx solid var(--surface-container-lowest);
  box-shadow: 0 16rpx 64rpx rgba(27, 28, 28, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.gold-avatar {
  width: 160rpx;
  height: 160rpx;
  border: 8rpx solid var(--surface-container-lowest);
  box-shadow: 0 16rpx 64rpx rgba(27, 28, 28, 0.06);
}

.podium-initial {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--on-surface-variant);
}

.podium-badge {
  position: absolute;
  bottom: -12rpx;
  right: -12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--surface-container-highest);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  color: var(--on-surface);
  border: 4rpx solid var(--surface-container-lowest);
  box-shadow: 0 4rpx 12rpx rgba(27, 28, 28, 0.08);
  z-index: 3;
}

.gold-badge {
  width: 56rpx;
  height: 56rpx;
  background: var(--tertiary-container);
  color: var(--on-tertiary-container);
  font-size: 28rpx;
  bottom: -16rpx;
  right: -16rpx;
}

.crown {
  position: absolute;
  top: -40rpx;
  font-size: 48rpx;
  z-index: 4;
}

.podium-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--on-surface);
  margin-bottom: 8rpx;
  text-align: center;
}

.gold-name {
  font-size: 32rpx;
  font-weight: 900;
}

.podium-score {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--secondary);
  margin-bottom: 16rpx;
}

.gold-score {
  font-size: 28rpx;
  color: var(--primary);
}

.podium-bar {
  width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 24rpx;
  position: relative;
}

.silver-bar {
  height: 260rpx;
  background: var(--surface-container-low);
  border-bottom: 8rpx solid var(--surface-container-highest);
}

.gold-bar {
  height: 360rpx;
  background: linear-gradient(to bottom, var(--primary-container), var(--primary));
  border-bottom: 8rpx solid var(--primary);
  box-shadow: 0 8rpx 0 0 var(--primary);
}

.bronze-bar {
  height: 200rpx;
  background: var(--surface-container-low);
  border-bottom: 8rpx solid var(--surface-container-highest);
}

.podium-bar-num {
  font-size: 56rpx;
  font-weight: 900;
  color: var(--surface-dim);
}

.gold-bar .podium-bar-num {
  color: var(--on-primary-container);
}

/* Zone Label */
.zone-label {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 32rpx 0;
}

.zone-line {
  flex: 1;
  height: 2rpx;
  background: var(--surface-dim);
}

.zone-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--secondary-fixed);
  padding: 8rpx 24rpx;
  border-radius: 9999rpx;
}

.zone-icon {
  font-size: 24rpx;
  color: var(--secondary);
  font-weight: 700;
}

.zone-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--secondary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.zone-text-plain {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--surface-dim);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.demotion {
  margin-top: 32rpx;
}

/* Rank List */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: var(--surface-container-lowest);
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(27, 28, 28, 0.06);
  position: relative;
  overflow: hidden;
}

.rank-item.warning {
  border: 2rpx solid var(--error-container);
}

.warning-stripe {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--error);
  border-radius: 32rpx 0 0 32rpx;
}

.rank-num {
  width: 64rpx;
  font-size: 36rpx;
  font-weight: 900;
  color: var(--surface-dim);
  text-align: center;
}

.rank-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--surface-container-high);
  margin: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.rank-initial {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--secondary);
}

.rank-emoji {
  font-size: 36rpx;
}

.rank-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rank-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--on-surface);
}

.warning-icon {
  font-size: 24rpx;
}

.rank-score {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--secondary);
}

.text-error {
  color: var(--error);
}

/* My Rank Float */
.my-rank-float {
  position: fixed;
  bottom: calc(160rpx + constant(safe-area-inset-bottom));
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  right: 32rpx;
  z-index: 40;
}

.my-rank-card {
  background: var(--surface-container-lowest);
  border: 4rpx solid var(--surface-container-high);
  border-radius: 32rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 32rpx 64rpx rgba(27, 28, 28, 0.06);
}

.my-rank-num {
  width: 64rpx;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--primary);
  text-align: center;
}

.my-rank-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--surface-container-high);
  border: 4rpx solid var(--primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
}

.my-rank-emoji {
  font-size: 40rpx;
}

.my-rank-info {
  flex: 1;
}

.my-rank-name {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: var(--on-surface);
  letter-spacing: -0.02em;
}

.my-rank-promo {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--secondary);
}

.my-rank-score {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--primary);
}

