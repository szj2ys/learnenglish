.page-container {
  min-height: 100vh;
  background-color: var(--surface);
}

/* Top Bar */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + constant(safe-area-inset-top));
  padding-top: calc(24rpx + env(safe-area-inset-top));
  background: rgba(251, 249, 248, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.icon {
  font-size: 36rpx;
  color: var(--on-surface-variant);
}

.app-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--on-surface);
  letter-spacing: -0.02em;
}

.top-bar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.streak-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(221, 173, 0, 0.1);
  padding: 12rpx 20rpx;
  border-radius: 9999rpx;
}

.icon-fire {
  font-size: 32rpx;
}

.streak-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--tertiary-container);
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--surface-container-lowest);
  box-shadow: 0 4rpx 16rpx rgba(27, 28, 28, 0.06);
}

.avatar-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--on-primary);
}

/* Welcome */
.welcome-section {
  margin-top: 16rpx;
  margin-bottom: 48rpx;
}

.welcome-title {
  display: block;
  font-size: 72rpx;
  font-weight: 900;
  color: var(--on-surface);
  line-height: 1.1;
  letter-spacing: -0.03em;
  margin-bottom: 16rpx;
}

.welcome-sub {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--on-surface-variant);
}

/* Quest Card */
.quest-card-wrapper {
  position: relative;
  margin-bottom: 48rpx;
}

.quest-card {
  background: var(--surface-container-lowest);
  border-radius: 32rpx;
  padding: 48rpx;
  border-bottom: 8rpx solid var(--surface-container-high);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.quest-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.quest-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--on-surface);
  margin-bottom: 8rpx;
}

.quest-sub {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--on-surface-variant);
}

.quest-count {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.count-current {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--primary-container);
}

.count-total {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--on-surface-variant);
  opacity: 0.5;
}

/* Progress Bar */
.progress-track {
  height: 40rpx;
  background: var(--surface-container-highest);
  border-radius: 9999rpx;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 4rpx 8rpx rgba(27, 28, 28, 0.06);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-container), var(--primary-fixed));
  border-radius: 9999rpx;
  position: relative;
  transition: width 0.5s ease;
}

.progress-shimmer {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 16rpx;
  right: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 9999rpx;
}

/* Quest Button */
.quest-btn {
  margin-top: 8rpx;
  font-size: 36rpx;
  padding: 40rpx;
  background: linear-gradient(105deg, var(--primary-container), var(--primary));
}

.btn-icon {
  font-size: 40rpx;
  margin-left: 8rpx;
}

/* Quick Start */
.quick-start-section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--on-surface);
  margin-bottom: 32rpx;
  letter-spacing: -0.02em;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
}

.quick-card {
  background: var(--surface-container-lowest);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  border-bottom: 12rpx solid var(--surface-container-high);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  transition: all 0.1s ease;
}

.quick-card:active {
  transform: translateY(4rpx);
  border-bottom-width: 4rpx;
}

.quick-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(27, 28, 28, 0.06);
}

.bg-secondary-fixed {
  background: var(--secondary-fixed);
}

.bg-tertiary-fixed {
  background: var(--tertiary-fixed);
}

.quick-icon-text {
  font-size: 56rpx;
}

.quick-label {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--on-surface);
}

/* Rank Banner */
.rank-banner {
  background: var(--surface-container-lowest);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 32rpx rgba(27, 28, 28, 0.06);
  border: 2rpx solid rgba(190, 203, 177, 0.15);
  margin-bottom: 48rpx;
}

.rank-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.rank-shield {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shield-icon {
  font-size: 72rpx;
  position: absolute;
}

.shield-num {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--on-primary);
  position: relative;
  z-index: 1;
}

.rank-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--on-surface);
}

.rank-desc {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--on-surface-variant);
}

.rank-arrow {
  font-size: 40rpx;
  color: var(--on-surface-variant);
  font-weight: 300;
}

