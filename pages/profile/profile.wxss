.page-profile {
  min-height: 100vh;
  background-color: var(--surface);
}

/* Top Bar */
.profile-top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + constant(safe-area-inset-top));
  padding-top: calc(24rpx + env(safe-area-inset-top));
  background: rgba(251, 249, 248, 0.9);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
}

.menu-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.menu-icon {
  font-size: 36rpx;
  color: var(--primary-container);
}

.profile-brand {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--primary-container);
  letter-spacing: -0.02em;
}

.streak-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.streak-icon {
  font-size: 36rpx;
}

/* Hero */
.profile-hero {
  position: relative;
  margin-top: 32rpx;
  margin-bottom: 64rpx;
}

.hero-card {
  background: var(--surface-container-low);
  border-radius: 32rpx;
  padding: 48rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 1;
  box-shadow: 0 16rpx 64rpx rgba(27, 28, 28, 0.06);
}

.hero-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-name {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--on-surface);
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.hero-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--secondary);
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.hero-avatar-wrap {
  position: relative;
}

.hero-avatar {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: var(--surface-container-lowest);
  border: 8rpx solid var(--surface-container-lowest);
  box-shadow: 0 16rpx 64rpx rgba(27, 28, 28, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-initial {
  font-size: 80rpx;
  font-weight: 900;
  color: var(--primary-container);
}

.hero-level-badge {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--tertiary-container);
  color: var(--on-tertiary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  border: 4rpx solid var(--surface-container-lowest);
}

.hero-deco {
  position: absolute;
  top: 32rpx;
  right: -16rpx;
  width: 75%;
  height: 100%;
  background: var(--surface-container-high);
  border-radius: 32rpx;
  z-index: 0;
}

/* Stats Section */
.stats-section {
  margin-bottom: 64rpx;
}

.section-title {
  margin-left: 16rpx;
}

.bento-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.bento-card {
  background: var(--surface-container-low);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.streak-card {
  grid-column: span 2;
  background: var(--surface-container-lowest);
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 64rpx rgba(27, 28, 28, 0.06);
}

.streak-deco {
  position: absolute;
  top: -32rpx;
  right: -32rpx;
  opacity: 0.1;
}

.streak-deco-icon {
  font-size: 180rpx;
}

.streak-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}

.streak-icon-inline {
  font-size: 32rpx;
}

.streak-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tertiary);
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.streak-value-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}

.streak-num {
  font-size: 80rpx;
  font-weight: 900;
  color: var(--on-surface);
  letter-spacing: -0.03em;
  line-height: 1;
}

.streak-unit {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--on-surface-variant);
}

.week-row {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  position: relative;
  z-index: 1;
}

.week-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
}

.week-dot-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--on-surface-variant);
}

.week-dot.active {
  background: var(--tertiary-container);
}

.week-dot.active .week-dot-text {
  color: var(--on-tertiary-container);
  font-weight: 700;
}

.week-dot.current {
  box-shadow: 0 0 0 4rpx var(--tertiary), 0 0 0 8rpx var(--surface-container-lowest);
}

.bento-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bento-icon {
  font-size: 32rpx;
}

.bento-label {
  font-size: 22rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.text-secondary {
  color: var(--secondary);
}

.text-primary {
  color: var(--primary);
}

.bento-value {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--on-surface);
  letter-spacing: -0.02em;
}

/* Achievements */
.achievements-section {
  margin-bottom: 64rpx;
}

.achievements-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
}

.view-all {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--secondary);
}

.achievements-scroll {
  background: var(--surface-container-low);
  border-radius: 32rpx;
  padding: 32rpx;
}

.achievements-row {
  display: flex;
  gap: 32rpx;
  padding-right: 32rpx;
}

.achievement-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
  flex-shrink: 0;
}

.achievement-item.locked {
  opacity: 0.5;
}

.achievement-badge {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 16rpx 64rpx rgba(27, 28, 28, 0.06);
  border: 4rpx solid var(--surface-container-lowest);
}

.achievement-badge.primary {
  background: var(--primary-container);
}

.achievement-badge.secondary {
  background: var(--secondary-container);
}

.achievement-badge.tertiary {
  background: var(--tertiary-container);
}

.achievement-badge.default {
  background: var(--surface-container-highest);
}

.achievement-icon {
  font-size: 56rpx;
}

.achievement-name {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--on-surface);
  text-align: center;
  line-height: 1.3;
}

/* CTA */
.profile-cta {
  margin-bottom: 48rpx;
}

.profile-btn {
  font-size: 36rpx;
  padding: 40rpx;
  gap: 16rpx;
}

